// OUISSAS QUALITÉ — base de données hébergée (PostgreSQL, ex. Neon).
// L'URL de connexion vient de la variable d'environnement DATABASE_URL,
// configurée dans le tableau de bord Vercel (jamais écrite en dur ici).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Rôles possibles (vérifiés en TypeScript, pas en enum natif — SQLite
// gère mal les enums, donc on reste en String simple ici) :
// ADMIN | QUALITY_MANAGER | DIRECTION | PROCESS_OWNER | AUDITOR | COLLABORATOR | READER

model Company {
  id          String   @id @default(cuid())
  name        String
  sector      String?
  logoUrl     String?
  address     String?
  city        String?
  country     String?
  employees   Int?
  codePattern String   @default("{TYPE}-{PROCESS}-{NUMBER}")
  createdAt   DateTime @default(now())

  users     User[]
  sites     Site[]
  processes Process[]
  diagnosticResponses DiagnosticResponse[]
  documents           Document[]
  nonConformities     NonConformity[]
  correctiveActions   CorrectiveAction[]
  risks               Risk[]
  suppliers           Supplier[]
  objectives          Objective[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("COLLABORATOR")
  siteId       String?
  site         Site?    @relation(fields: [siteId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Site {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  code      String
  name      String
  type      String
  city      String?
  address   String?
  employees Int?
  active    Boolean  @default(true)
  users     User[]

  @@unique([companyId, code])
}

model Process {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  code      String
  name      String
  type      String
  owner     String?
  purpose   String?

  @@unique([companyId, code])
}

// Référentiel qualité — configurable, pas codé en dur dans plusieurs
// fichiers. Permet d'ajouter d'autres normes (ISO 14001, 45001...) plus
// tard sans reconstruire l'application (voir architecture initiale, §10).
model Standard {
  id      String   @id @default(cuid())
  code    String   @unique
  name    String
  clauses Clause[]
}

model Clause {
  id           String        @id @default(cuid())
  standardId   String
  standard     Standard      @relation(fields: [standardId], references: [id])
  code         String
  title        String
  requirements Requirement[]

  @@unique([standardId, code])
}

model Requirement {
  id          String               @id @default(cuid())
  clauseId    String
  clause      Clause               @relation(fields: [clauseId], references: [id])
  code        String
  question    String
  explanation String?
  responses   DiagnosticResponse[]

  @@unique([clauseId, code])
}

model DiagnosticResponse {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id])
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id])
  status        String? // conforme | partiel | non_conforme | na
  comment       String?
  evidence      String?
  updatedAt     DateTime    @updatedAt

  @@unique([companyId, requirementId])
}

model Document {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  code         String
  title        String
  type         String
  process      String?
  version      String    @default("1.0")
  status       String    @default("brouillon")
  author       String?
  dateCreated  DateTime  @default(now())
  dateRevision DateTime?
  content      Json?

  @@unique([companyId, code])
}

model NonConformity {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id])
  ref         String
  date        DateTime           @default(now())
  process     String?
  description String
  origin      String?
  severity    String             @default("mineure") // mineure|majeure|critique
  status      String             @default("ouverte")  // ouverte|en_analyse|action_en_cours|en_verification|cloturee
  closed      Boolean            @default(false)
  actions     CorrectiveAction[]

  @@unique([companyId, ref])
}

model CorrectiveAction {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  code            String
  description     String
  owner           String?
  deadline        DateTime?
  priority        String         @default("Moyenne")
  status          String         @default("a_faire") // a_faire|en_cours|en_verification|cloture
  nonConformityId String?
  nonConformity   NonConformity? @relation(fields: [nonConformityId], references: [id])

  @@unique([companyId, code])
}

model Risk {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  ref         String
  process     String?
  risk        String
  cause       String?
  consequence String?
  probability Int
  severity    Int
  owner       String?
  status      String  @default("identifie")
  controls    String?

  @@unique([companyId, ref])
}

model Supplier {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  name       String
  activity   String?
  quality    Int     @default(0)
  price      Int     @default(0)
  delay      Int     @default(0)
  reactivity Int     @default(0)
  status     String  @default("identifie")
}

model Objective {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  objective String
  kpi       String
  target    Float
  current   Float
  unit      String?
  owner     String?
  process   String?
}
